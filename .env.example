# ── Required ────────────────────────────────────────────────────────────────
# Master secret. All other keys (session signing, settings encryption) are
# HKDF-derived from this. Generate with: openssl rand -hex 32
NEXUS_SECRET_KEY=

# Ferrum Edge Admin API base URL (server-side only; never exposed to browsers)
FERRUM_ADMIN_URL=http://127.0.0.1:9000

# Shared secret used to mint short-lived JWTs for the Ferrum Edge Admin API.
# Must match FERRUM_ADMIN_JWT_SECRET on the gateway. Min 32 characters.
FERRUM_ADMIN_JWT_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8787
# Public origin of the portal, used in emails and CORS (e.g. https://portal.example.com)
NEXUS_PUBLIC_URL=http://127.0.0.1:5173
# Set true only when running behind a TLS-terminating proxy so cookies are Secure
NEXUS_TRUST_PROXY=false
NEXUS_LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
# One of: sqlite | postgres | mysql | mongodb
NEXUS_DB_DRIVER=sqlite
# Ignored for sqlite (uses NEXUS_SQLITE_PATH). Examples:
#   postgres://nexus:secret@127.0.0.1:5432/nexus
#   mysql://nexus:secret@127.0.0.1:3306/nexus
#   mongodb://127.0.0.1:27017/nexus?replicaSet=rs0
NEXUS_DB_URL=
NEXUS_SQLITE_PATH=./data/nexus.sqlite
# MongoDB standalone servers cannot run multi-document transactions; Nexus
# refuses to start against one unless this is true (dev only).
NEXUS_DB_ALLOW_STANDALONE=false

# ── Ferrum Edge integration ─────────────────────────────────────────────────
# Namespace Nexus manages on the gateway
FERRUM_NAMESPACE=nexus
# JWT lifetime in seconds for Admin API calls
FERRUM_ADMIN_JWT_TTL=60
# Optional: path to a CA bundle (PEM) for a TLS-protected Admin API
FERRUM_ADMIN_CA_FILE=
# Set true to allow plaintext http:// Admin URLs outside local development
FERRUM_ADMIN_ALLOW_INSECURE_HTTP=false

# ── Email (optional; can also be configured in the admin UI) ───────────────
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_SECURE=false
NEXUS_SMTP_USER=
NEXUS_SMTP_PASSWORD=
NEXUS_EMAIL_FROM="Ferrum Nexus <no-reply@example.com>"

# ── Sessions ────────────────────────────────────────────────────────────────
# Session idle lifetime in seconds (default 12h)
NEXUS_SESSION_TTL=43200

# Copied to `.env`, this file is read by `npm run migrate` and `npm run dev`
# (from the working directory or its parent). Variables already present in
# the environment always take precedence over it; production deployments
# inject the environment directly and ship no .env file.
#
# Two of them are no longer allowed to win *silently*: if FERRUM_NAMESPACE or
# FERRUM_ADMIN_URL is exported with a value different from the one below, the
# server prints a startup banner naming both and, outside NEXUS_ENV=production,
# refuses to start until you unset it, edit this file to agree, or set
# NEXUS_ALLOW_ENV_OVERRIDE=true. A leftover `export FERRUM_NAMESPACE` from other
# tooling otherwise redirects every publish at a namespace the gateway does not
# route, and every invoke_url 404s while this file says otherwise.
# ── Required ────────────────────────────────────────────────────────────────
# Master secret. All other keys (session signing, settings encryption) are
# HKDF-derived from this. Generate with: openssl rand -hex 32
NEXUS_SECRET_KEY=

# Ferrum Edge Admin API base URL (server-side only; never exposed to browsers)
FERRUM_ADMIN_URL=http://127.0.0.1:9000

# Shared secret used to mint short-lived JWTs for the Ferrum Edge Admin API.
# Must match FERRUM_ADMIN_JWT_SECRET on the gateway. Min 32 characters.
FERRUM_ADMIN_JWT_SECRET=

# ── First-run bootstrap ─────────────────────────────────────────────────────
# Secret the founding registration must present to become the portal's
# super_admin. Leave it blank and the server generates one per process and
# prints it at startup while the portal has no active super_admin — fine for a
# single instance, useless behind a load balancer (each instance would print
# its own). Set it for a multi-instance deployment, or to keep one value across
# restarts. Minimum 16 characters. Generate with: openssl rand -hex 32
# Ignored once an active super_admin exists.
NEXUS_BOOTSTRAP_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8787
# Vite `npm run dev` only (the production image serves the SPA from the BFF).
# Defaults match a single local stack: web 5173, API proxy http://127.0.0.1:8787.
# `NEXUS_PORT` is the API bind port the BFF already uses; the SPA proxies `/api`
# to that port (and `NEXUS_HOST`, treating 0.0.0.0 / :: as 127.0.0.1) unless
# `NEXUS_API_PROXY_TARGET` is set. `VITE_DEV_PORT` is an alias for
# `NEXUS_WEB_PORT`; `NEXUS_WEB_PORT` wins if both are set. Invalid values fail
# the Vite process with the variable name in the error.
#
# Run two stacks side by side (second clone / Foundry) by giving the second
# checkout its own ports and SQLite file:
#   NEXUS_PORT=8788
#   NEXUS_WEB_PORT=5175
#   NEXUS_PUBLIC_URL=http://127.0.0.1:5175
#   NEXUS_SQLITE_PATH=./data/nexus-b.sqlite
#   # NEXUS_API_PROXY_TARGET=http://127.0.0.1:8788   # only if not derived
NEXUS_WEB_PORT=5173
# VITE_DEV_PORT=5173
# NEXUS_API_PROXY_TARGET=http://127.0.0.1:8787
# Public origin of the portal, used in emails and CORS (e.g. https://portal.example.com)
NEXUS_PUBLIC_URL=http://127.0.0.1:5173
# Which proxies may set X-Forwarded-For. Empty (the default) trusts none, so
# request.ip is always the socket address — that is what the /api/auth rate
# limiter and every audit row key on. Set either an integer hop count counted
# from the right of the header, or a comma-separated allowlist of proxy IPs /
# CIDR blocks (loopback, linklocal and uniquelocal are also accepted). Each
# entry must be a real IPv4/IPv6 address with an optional prefix of 1-32 (IPv4)
# or 1-128 (IPv6); anything else is a configuration error naming this variable:
#   NEXUS_TRUSTED_PROXIES=1
#   NEXUS_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.7
NEXUS_TRUSTED_PROXIES=
# DEPRECATED: alias for NEXUS_TRUSTED_PROXIES=1. Kept so existing deployments
# keep working; prefer an explicit allowlist above.
NEXUS_TRUST_PROXY=false
# Mark the session/CSRF cookies Secure and enable HSTS. Defaults to true unless
# NEXUS_ENV=development. Set false only to serve the portal over plaintext http.
NEXUS_COOKIE_SECURE=true
NEXUS_LOG_LEVEL=info
# production | development | test
NEXUS_ENV=production
# Disable only in tests; guards sensitive /api/auth POSTs (20/min/IP) against
# credential guessing. /api/auth/me and /api/auth/captcha reads share a separate
# 120/min/IP budget. Also guards /api/health* (120/min/IP), the mutating
# /api/apis/* routes (30/min per account) against publish floods and the
# messaging write paths (10 new threads and 30 replies per minute, per account)
NEXUS_RATE_LIMIT_ENABLED=true
# How long /api/health reuses a database/gateway probe, in ms (0 disables).
# The endpoints are public, so without this each request costs a DB query and
# an authenticated Admin API call.
NEXUS_HEALTH_CACHE_MS=5000
# Total Edge deadline for /api/health* only (100–5000 ms), independent of admin calls.
# Keep the external healthcheck timeout above this plus DB/HTTP overhead.
# The shipped image allows 10 s; Nexus cannot inspect orchestrator overrides.
NEXUS_HEALTH_PROBE_TIMEOUT_MS=1500
# How often Nexus checks that the gateway still holds the consumer and proxy ids
# it stored, in ms (0 disables the periodic pass; the admin endpoint still runs
# one on demand). Retargeting FERRUM_ADMIN_URL at a different or rebuilt gateway
# leaves every stored id pointing at nothing while /api/health stays green; this
# is the pass that notices, and it reports through edge.reconciliation.
NEXUS_GATEWAY_RECONCILE_INTERVAL_MS=900000
# Most stored references of each kind one pass checks — a bound on the Admin API
# reads a very large catalog generates. A pass that stops at the bound says so.
NEXUS_GATEWAY_RECONCILE_SAMPLE=200
# How many APIs one account may own at a time. Registration may be open, and
# each publish stores a document and allocates a gateway proxy, plugin configs
# and a listen path, so an unbounded account can exhaust both. 0 = unlimited.
NEXUS_MAX_APIS_PER_OWNER=50
# Historical spec revisions kept per API, on top of the current one. Older
# non-current revisions are pruned in the transaction that makes a new one
# current. Minimum 1 — the previous revision is what a failed gateway write
# rolls back to. This is the other half of the storage bound: aggregate spec
# storage per account is 2 MiB x (this + 1) x NEXUS_MAX_APIS_PER_OWNER.
NEXUS_SPEC_HISTORY_LIMIT=10
# How many portal messages one account may post in a rolling 24 hours. The
# per-minute limiter bounds a burst; this bounds the day, because every message
# durably costs a message row, an audit row, and — in a platform thread — a
# notification row per administrator. 0 disables the budget. Admins are subject
# to it too.
NEXUS_MAX_MESSAGES_PER_USER_PER_DAY=200
# How many access requests one account may create in a rolling 24 hours.
# Cancelled rows count toward the ceiling so create→cancel→create cannot loop.
# 0 disables the budget.
NEXUS_MAX_ACCESS_REQUESTS_PER_USER_PER_DAY=20
# How long GET /api/branding reuses its assembled payload (milliseconds).
# Within the window the response is cacheable and concurrent callers share one
# assembly. Local settings writes invalidate immediately and bootstrap_required is
# never cached; the TTL bounds cross-instance staleness of the other fields.
# Browser/CDN copies retain their max-age.
# 0 disables the cache.
# NEXUS_BRANDING_CACHE_MS=5000
# How many recipients one god-mode broadcast may address. A broadcast writes a
# notification, a platform-inbox message and (with send_email) a queued mail per
# recipient, and its rows deliberately do NOT draw on the sending admin's daily
# message budget — one announcement to a portal larger than that budget used to
# refuse every ordinary message they sent for a day. This is the bound instead.
# Set it above the portal's account count for an announcement to reach everyone.
# 0 removes the ceiling.
NEXUS_MAX_BROADCAST_RECIPIENTS=5000
# How many god-mode broadcasts one administrator may send in a rolling 24 hours,
# counted from their own god.broadcast audit rows. The ceiling above bounds one
# announcement; this bounds a loop of them. 0 removes the ceiling.
NEXUS_MAX_BROADCASTS_PER_DAY=20
# How many recipients one mass-email campaign may address. Each recipient is
# one outbox row holding a full rendered copy, delivered through the same outbox
# as verification and password-reset mail. The fan-out is queued in transactions
# of at most 200 recipients (fewer for large messages), so other writes are not
# stalled behind a whole campaign. 0 removes the ceiling.
NEXUS_MAX_MASS_EMAIL_RECIPIENTS=5000
# How many rendered bytes one mass-email campaign may queue in total: one
# rendered message (subject, HTML and text, sized for the longest recipient name
# and address after HTML escaping) times the number of recipients. The recipient
# ceiling and the body-length limits bound each dimension alone; this bounds
# their product. Default 67108864 (64 MiB). 0 removes the ceiling.
NEXUS_MAX_MASS_EMAIL_BYTES=67108864
# How many mass-email campaigns one administrator may start in a rolling 24
# hours, counted from their own admin.mass_email audit rows (one per campaign;
# a retry with the same idempotency_key, content and audience is not charged
# again, and a reused key with different content is refused). Default 5 while
# campaign and security mail share one outbox queue. 0 removes the ceiling.
NEXUS_MAX_MASS_EMAILS_PER_DAY=5
# Directory of the built SPA to serve (defaults to web/dist when present)
NEXUS_WEB_DIST=
# Whether providers may publish APIs whose upstream is a loopback, private
# (RFC 1918 / CGNAT / link-local), or *.internal / *.local destination. A proxy
# is an egress path from the gateway's network, so the default refuses them.
# At false, other upstream hostnames are RESOLVED and refused if any A/AAAA
# answer is private or the name does not resolve — so the portal needs working
# public DNS. Set true only for a portal that fronts internal services (or for
# local development, where the upstream is host.docker.internal).
NEXUS_ALLOW_PRIVATE_UPSTREAMS=false
# Whether backend writes may proceed when the gateway cannot attest public-only
# egress on its own data plane, as in a control-plane/data-plane pairing. It
# relaxes only that attestation: the upstream screening above still runs. Set
# true only when every data plane enforces FERRUM_BACKEND_ALLOW_IPS=public
# without allow CIDRs. Startup logs a warning while it is set. It still needs
# the gateway to report public_only_guaranteed=true, which Edge v0.9.13 reports
# only for a local data plane, so it no longer admits a control plane. A control
# plane whose data planes all attest public-only (Edge v0.9.14) needs no opt-out
# once NEXUS_EXPECTED_DATA_PLANES is set; see docs/operations.md.
NEXUS_ALLOW_UNATTESTED_EDGE_EGRESS=false
# Control-plane/data-plane pairings only: how many data-plane processes
# (replicas or pods) the namespace runs in total, across every control plane
# (a positive integer). Each Edge data-plane process reports its own random
# node_id for its lifetime, even when replicas share one CP/DP secret. A control
# plane's data-plane attestation (Edge v0.9.14) proves public-only egress only
# while at least this many distinct node_ids are connected to the control plane
# at FERRUM_ADMIN_URL, every connected stream attests it, and a node_id counts
# only once it has been listed long enough that a restarted data plane cannot
# count twice. Blank (the default): an attestation never proves it. Anything
# but a positive integer refuses startup.
NEXUS_EXPECTED_DATA_PLANES=

# Acknowledge that an exported FERRUM_NAMESPACE / FERRUM_ADMIN_URL is meant to
# beat this file. Outside NEXUS_ENV=production a disagreement refuses startup;
# set this to true to keep the exported value and start anyway. Production is
# warn-only and ignores this flag — there the environment IS the configuration.
NEXUS_ALLOW_ENV_OVERRIDE=false

# ── Database ────────────────────────────────────────────────────────────────
# One of: sqlite | postgres | mysql | mongodb
NEXUS_DB_DRIVER=sqlite
# Ignored for sqlite (uses NEXUS_SQLITE_PATH). Examples:
#   postgres://nexus:secret@127.0.0.1:5432/nexus
#   mysql://nexus:secret@127.0.0.1:3306/nexus
#   mongodb://127.0.0.1:27017/nexus?replicaSet=rs0
NEXUS_DB_URL=
NEXUS_SQLITE_PATH=./data/nexus.sqlite
# MongoDB standalone servers cannot run multi-document transactions; Nexus
# refuses to start against one unless this is true (dev only).
NEXUS_DB_ALLOW_STANDALONE=false

# ── Ferrum Edge integration ─────────────────────────────────────────────────
# Namespace Nexus manages on the gateway. Must match ^[a-zA-Z0-9][a-zA-Z0-9._-]*$
# and be at most 128 characters (the MySQL namespace columns are VARCHAR(128)).
#
# MUST EQUAL THE GATEWAY'S OWN FERRUM_NAMESPACE (it defaults to `ferrum` when
# unset there). The Admin API accepts a write into any namespace, but one
# gateway process's DATA PLANE routes exactly one — so publishing into any
# other namespace succeeds, shows a green catalog entry, and 404s on the
# listener forever. Nexus reports the mismatch as /api/health
# `edge.reason=namespace_unserved` and refuses new publishes with
# 409 EDGE_NAMESPACE_UNSERVED. Read the gateway's side from its authenticated
# GET /health, field `namespace.active`.
FERRUM_NAMESPACE=nexus
# Public origin of the gateway's PROXY listener — where clients send API traffic.
# Not the Admin API and not NEXUS_PUBLIC_URL. Scheme, host and port only, no path.
# The catalog builds each API's invoke_url from it; leave blank and APIs report a
# null invoke_url. An admin can override it in Settings → Gateway.
FERRUM_GATEWAY_PUBLIC_URL=
# JWT lifetime in seconds for Admin API calls (gateway caps at 3600)
FERRUM_ADMIN_JWT_TTL=60
# Must match the gateway's FERRUM_ADMIN_JWT_ISSUER
FERRUM_ADMIN_JWT_ISSUER=ferrum-edge
# Only set when the gateway configures FERRUM_ADMIN_JWT_AUDIENCE
FERRUM_ADMIN_JWT_AUDIENCE=
# Admin API request timeout in milliseconds
FERRUM_ADMIN_TIMEOUT_MS=5000
# Must match the gateway's FERRUM_MAX_CREDENTIALS_PER_TYPE (default 2)
FERRUM_MAX_CREDENTIALS_PER_TYPE=2
# Optional: path to a CA bundle (PEM) for a TLS-protected Admin API
FERRUM_ADMIN_CA_FILE=
# Set true to allow plaintext http:// Admin URLs outside local development
FERRUM_ADMIN_ALLOW_INSECURE_HTTP=false
# Where Edge keeps rate-limit counters for the quotas Nexus publishes:
#   local (default) — in memory, PER GATEWAY PROCESS. N data-plane replicas
#                     therefore enforce N times the quota a provider chose.
#   redis           — one shared counter across every replica.
# Applies to rate limits saved after the change; existing APIs pick it up the
# next time their rate limit is saved.
FERRUM_RATE_LIMIT_SYNC_MODE=local
# Required when FERRUM_RATE_LIMIT_SYNC_MODE=redis. redis:// or rediss:// only.
FERRUM_RATE_LIMIT_REDIS_URL=
# Upgrade a redis:// endpoint to TLS (rediss:// already implies it)
FERRUM_RATE_LIMIT_REDIS_TLS=false

# ── Email (optional; can also be configured in the admin UI) ───────────────
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_SECURE=false
NEXUS_SMTP_USER=
NEXUS_SMTP_PASSWORD=
NEXUS_EMAIL_FROM="Ferrum Nexus <no-reply@example.com>"
# Operator-only: additional exact host[:port] destinations for email templates.
# Empty permits only the NEXUS_PUBLIC_URL origin. Comma-separated, no schemes,
# paths, credentials or wildcards; ports must be non-default (e.g. docs.test:8443).
# Allowlist only trusted hosts. Action URL placeholders must still be whole links.
NEXUS_EMAIL_TEMPLATE_ALLOWED_LINK_HOSTS=

# ── Sessions ────────────────────────────────────────────────────────────────
# Session idle lifetime in seconds (default 12h)
NEXUS_SESSION_TTL=43200

# ── CAPTCHA break-glass ─────────────────────────────────────────────────────
# enforced (default) | disabled. LEAVE THIS UNSET in normal operation.
#
# CAPTCHA is configured in Admin -> Settings, not here, and it fails closed: a
# wrong site key, a secret that no longer decrypts or an unreachable vendor
# makes every password login answer 400 CAPTCHA_FAILED — including the super
# admin's, so nobody can switch it off again. Saving an activation now requires
# a captcha_token the new configuration verifies, which prevents most of that;
# this is the way back when a portal is already stuck (or the vendor breaks
# afterwards).
#
# `disabled` makes register and login skip verification and hides the widget,
# WITHOUT changing a stored setting. The server logs a banner at startup while
# it is set, GET /api/admin/settings reports captcha.enforcement, and every
# session it admits is audited with captcha_bypassed: true. Sign in, fix the
# configuration, then remove this variable and restart — a portal left running
# this way has no CAPTCHA on registration at all.
#
# Deliberately not a boolean: 0/false/off are refused at startup. It cannot be
# set through the API. See docs/operations.md, "Recovering a portal locked out
# by CAPTCHA".
# NEXUS_CAPTCHA_ENFORCEMENT=enforced

# ── Single sign-on (OpenID Connect) ─────────────────────────────────────────
# Providers can also be added in Admin -> Settings -> Single sign-on; the ones
# declared here are read-only there. A JSON array, one object per provider;
# only id, issuer and client_id are required. The redirect URI to register at
# the provider is NEXUS_PUBLIC_URL + /api/auth/sso/<id>/callback. Issuers must
# use https://. See docs/operations.md, "Single sign-on (OpenID Connect)".
#   NEXUS_OIDC_PROVIDERS=[{"id":"corp","display_name":"Corporate SSO","issuer":"https://idp.example.com/realms/corp","client_id":"nexus","role_mappings":[{"claim":"groups","value":"nexus-admins","role":"admin"}]}]
NEXUS_OIDC_PROVIDERS=
# A provider's client secret, instead of "client_secret" in the JSON above:
# NEXUS_OIDC_CLIENT_SECRET_<ID>, with the id upper-cased and - as _.
#   NEXUS_OIDC_CLIENT_SECRET_CORP=
# Development only: accept a plain http:// issuer on exactly localhost,
# 127.0.0.1 or ::1. Every other issuer must be https://.
NEXUS_OIDC_ALLOW_HTTP_LOOPBACK=false
# Let provider requests reach private, loopback and reserved addresses, for an
# identity provider on a private network. Off, every provider host (and every
# endpoint its discovery document names) must resolve to public addresses.
NEXUS_OIDC_ALLOW_PRIVATE_ADDRESSES=false
# Under the sso_only login policy, still accept password sign-in for
# super_admin accounts — the way back in when the identity provider is down.
# Environment-only on purpose; every such sign-in is audited with
# break_glass: true. Leave false unless you need it.
NEXUS_SSO_BREAK_GLASS_LOCAL_LOGIN=false

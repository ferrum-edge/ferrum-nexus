# Ferrum Nexus environment template
# Copy to `.env` and edit. Required values are marked REQUIRED.

# ---- Server ----
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8787
NEXUS_PUBLIC_URL=http://127.0.0.1:8787
# 32-byte hex secret used to derive cookie signing keys and encrypt runtime settings. REQUIRED.
NEXUS_SECRET_KEY=
# Set to "production" in deployment
NODE_ENV=development
# Comma-separated list of trusted origins for the SPA. Defaults to NEXUS_PUBLIC_URL.
NEXUS_CORS_ORIGINS=http://127.0.0.1:5173

# ---- Database ----
# One of: sqlite | postgres | mysql | mongodb
NEXUS_DB_DRIVER=sqlite
# Required for postgres/mysql/mongodb. For sqlite, defaults to ./data/nexus.sqlite.
NEXUS_DB_URL=

# ---- Sessions ----
NEXUS_SESSION_COOKIE_NAME=nexus_sid
NEXUS_SESSION_TTL_SECONDS=86400
NEXUS_SESSION_SECURE=false

# ---- Ferrum Edge Admin API ----
# REQUIRED. Base URL of the Ferrum Edge Admin API.
FERRUM_ADMIN_URL=http://127.0.0.1:8000
# REQUIRED. HS256 JWT secret used to sign Admin API tokens (matches Edge config).
FERRUM_ADMIN_JWT_SECRET=
# Issuer/subject embedded in the Admin API JWT.
FERRUM_ADMIN_JWT_ISSUER=ferrum-nexus
FERRUM_ADMIN_JWT_SUBJECT=nexus-bff
# Role claim. Use "admin" for full admin or a more restricted role.
FERRUM_ADMIN_JWT_ROLE=admin
# Token TTL in seconds.
FERRUM_ADMIN_JWT_TTL=300
# Default namespace for catalog operations. Can be overridden per-asset.
FERRUM_DEFAULT_NAMESPACE=default
# Path to a CA bundle for TLS verification of Edge (optional).
FERRUM_ADMIN_CA_PATH=

# ---- Email ----
NEXUS_EMAIL_FROM=Ferrum Nexus <noreply@example.com>
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USERNAME=
NEXUS_SMTP_PASSWORD=
NEXUS_SMTP_SECURE=false

# ---- Frontend dev ----
VITE_API_BASE=/api

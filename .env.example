# ── Required ────────────────────────────────────────────────────────────────
# Master secret. All other keys (session signing, settings encryption) are
# HKDF-derived from this. Generate with: openssl rand -hex 32
NEXUS_SECRET_KEY=

# Ferrum Edge Admin API base URL (server-side only; never exposed to browsers)
FERRUM_ADMIN_URL=http://127.0.0.1:9000

# Shared secret used to mint short-lived JWTs for the Ferrum Edge Admin API.
# Must match FERRUM_ADMIN_JWT_SECRET on the gateway. Min 32 characters.
FERRUM_ADMIN_JWT_SECRET=

# ── First-run bootstrap ─────────────────────────────────────────────────────
# Secret the very first registration must present to become the portal's
# founding super_admin. Leave it blank and the server generates one per process
# and prints it at startup while the user table is empty — fine for a single
# instance, useless behind a load balancer (each instance would print its own).
# Set it for a multi-instance deployment, or to keep one value across restarts.
# Minimum 16 characters. Generate with: openssl rand -hex 32
# Ignored once any account exists.
NEXUS_BOOTSTRAP_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8787
# Public origin of the portal, used in emails and CORS (e.g. https://portal.example.com)
NEXUS_PUBLIC_URL=http://127.0.0.1:5173
# Which proxies may set X-Forwarded-For. Empty (the default) trusts none, so
# request.ip is always the socket address — that is what the /api/auth rate
# limiter and every audit row key on. Set either an integer hop count counted
# from the right of the header, or a comma-separated allowlist of proxy IPs /
# CIDR blocks (loopback, linklocal and uniquelocal are also accepted):
#   NEXUS_TRUSTED_PROXIES=1
#   NEXUS_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.7
NEXUS_TRUSTED_PROXIES=
# DEPRECATED: alias for NEXUS_TRUSTED_PROXIES=1. Kept so existing deployments
# keep working; prefer an explicit allowlist above.
NEXUS_TRUST_PROXY=false
# Mark the session/CSRF cookies Secure and enable HSTS. Defaults to true unless
# NEXUS_ENV=development. Set false only to serve the portal over plaintext http.
NEXUS_COOKIE_SECURE=true
NEXUS_LOG_LEVEL=info
# production | development | test
NEXUS_ENV=production
# Disable only in tests; guards /api/auth/* (20/min/IP) against credential
# guessing, /api/health* (120/min/IP) against probe floods, the mutating
# /api/apis/* routes (30/min per account) against publish floods and the
# messaging write paths (10 new threads and 30 replies per minute, per account)
NEXUS_RATE_LIMIT_ENABLED=true
# How long /api/health reuses a database/gateway probe, in ms (0 disables).
# The endpoints are public, so without this each request costs a DB query and
# an authenticated Admin API call.
NEXUS_HEALTH_CACHE_MS=5000
# How many APIs one account may own at a time. Registration may be open, and
# each publish stores a document and allocates a gateway proxy, plugin configs
# and a listen path, so an unbounded account can exhaust both. 0 = unlimited.
# Aggregate spec storage per account is bounded by 2 MiB x this value.
NEXUS_MAX_APIS_PER_OWNER=50
# How many portal messages one account may post in a rolling 24 hours. The
# per-minute limiter bounds a burst; this bounds the day, because every message
# durably costs a message row, an audit row, and — in a platform thread — a
# notification row per administrator. 0 disables the budget. Admins are subject
# to it too.
NEXUS_MAX_MESSAGES_PER_USER_PER_DAY=200
# Directory of the built SPA to serve (defaults to web/dist when present)
NEXUS_WEB_DIST=
# Whether providers may publish APIs whose upstream is a loopback, private
# (RFC 1918 / CGNAT / link-local), or *.internal / *.local destination. A proxy
# is an egress path from the gateway's network, so the default refuses them.
# At false, other upstream hostnames are RESOLVED and refused if any A/AAAA
# answer is private or the name does not resolve — so the portal needs working
# public DNS. Set true only for a portal that fronts internal services (or for
# local development, where the upstream is host.docker.internal).
NEXUS_ALLOW_PRIVATE_UPSTREAMS=false

# ── Database ────────────────────────────────────────────────────────────────
# One of: sqlite | postgres | mysql | mongodb
NEXUS_DB_DRIVER=sqlite
# Ignored for sqlite (uses NEXUS_SQLITE_PATH). Examples:
#   postgres://nexus:secret@127.0.0.1:5432/nexus
#   mysql://nexus:secret@127.0.0.1:3306/nexus
#   mongodb://127.0.0.1:27017/nexus?replicaSet=rs0
NEXUS_DB_URL=
NEXUS_SQLITE_PATH=./data/nexus.sqlite
# MongoDB standalone servers cannot run multi-document transactions; Nexus
# refuses to start against one unless this is true (dev only).
NEXUS_DB_ALLOW_STANDALONE=false

# ── Ferrum Edge integration ─────────────────────────────────────────────────
# Namespace Nexus manages on the gateway
FERRUM_NAMESPACE=nexus
# Public origin of the gateway's PROXY listener — where clients send API traffic.
# Not the Admin API and not NEXUS_PUBLIC_URL. Scheme, host and port only, no path.
# The catalog builds each API's invoke_url from it; leave blank and APIs report a
# null invoke_url. An admin can override it in Settings → Gateway.
FERRUM_GATEWAY_PUBLIC_URL=
# JWT lifetime in seconds for Admin API calls (gateway caps at 3600)
FERRUM_ADMIN_JWT_TTL=60
# Must match the gateway's FERRUM_ADMIN_JWT_ISSUER
FERRUM_ADMIN_JWT_ISSUER=ferrum-edge
# Only set when the gateway configures FERRUM_ADMIN_JWT_AUDIENCE
FERRUM_ADMIN_JWT_AUDIENCE=
# Admin API request timeout in milliseconds
FERRUM_ADMIN_TIMEOUT_MS=5000
# Must match the gateway's FERRUM_MAX_CREDENTIALS_PER_TYPE (default 2)
FERRUM_MAX_CREDENTIALS_PER_TYPE=2
# Optional: path to a CA bundle (PEM) for a TLS-protected Admin API
FERRUM_ADMIN_CA_FILE=
# Set true to allow plaintext http:// Admin URLs outside local development
FERRUM_ADMIN_ALLOW_INSECURE_HTTP=false
# Where Edge keeps rate-limit counters for the quotas Nexus publishes:
#   local (default) — in memory, PER GATEWAY PROCESS. N data-plane replicas
#                     therefore enforce N times the quota a provider chose.
#   redis           — one shared counter across every replica.
# Applies to rate limits saved after the change; existing APIs pick it up the
# next time their rate limit is saved.
FERRUM_RATE_LIMIT_SYNC_MODE=local
# Required when FERRUM_RATE_LIMIT_SYNC_MODE=redis. redis:// or rediss:// only.
FERRUM_RATE_LIMIT_REDIS_URL=
# Upgrade a redis:// endpoint to TLS (rediss:// already implies it)
FERRUM_RATE_LIMIT_REDIS_TLS=false

# ── Email (optional; can also be configured in the admin UI) ───────────────
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_SECURE=false
NEXUS_SMTP_USER=
NEXUS_SMTP_PASSWORD=
NEXUS_EMAIL_FROM="Ferrum Nexus <no-reply@example.com>"

# ── Sessions ────────────────────────────────────────────────────────────────
# Session idle lifetime in seconds (default 12h)
NEXUS_SESSION_TTL=43200

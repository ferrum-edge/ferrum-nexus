# Copy to `e2e/.env` and fill in, or let `./e2e/run.sh` generate one.
#
# Every secret here is per-run and throwaway. `run.sh` mints fresh values on
# each invocation rather than shipping defaults, because a compose file with a
# working secret in it is a secret that ends up in somebody's real deployment.

# The Ferrum Edge image comes from ../release/compatibility.env when run.sh
# generates e2e/.env. Set it in e2e/.env or export it to test another image.

# The packaged portal. `run.sh` builds this from docker/Dockerfile unless
# NEXUS_IMAGE already names one (which is how CI reuses its build).
NEXUS_IMAGE=ferrum-nexus:e2e

NEXUS_SECRET_KEY=
NEXUS_BOOTSTRAP_TOKEN=
NEXUS_DB_PASSWORD=
FERRUM_ADMIN_JWT_SECRET=
# At least 32 bytes; the gateway refuses to build the basic_auth plugin without it.
FERRUM_BASIC_AUTH_HMAC_SECRET=

# Loopback ports. Change them if something else on the machine already listens.
NEXUS_PORT=8787
FERRUM_PROXY_PORT=8000
FERRUM_ADMIN_PORT=9000
MAILPIT_HTTP_PORT=8025

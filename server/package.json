{
  "name": "@ferrum-nexus/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-db-schema.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "rotate-secret-key": "tsx src/db/rotate-key-cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --experimental-test-coverage --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@ferrum-nexus/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.1",
    "undici": "^7.29.1",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.11",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}

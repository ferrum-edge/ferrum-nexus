{
  "name": "@ferrum-nexus/server",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-db-schema.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "rotate-secret-key": "tsx src/db/rotate-key-cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --experimental-test-coverage --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@ferrum-nexus/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.1",
    "pg": "^8.13.1",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}

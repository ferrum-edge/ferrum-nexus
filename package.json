{
  "name": "ferrum-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace shared",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "dev": "npm run build --workspace shared && concurrently -n server,web -c green,blue \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "migrate": "npm run build --workspace shared && npm run migrate --workspace server",
    "pretypecheck": "npm run build --workspace shared",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run typecheck",
    "pretest": "npm run build --workspace shared",
    "test": "npm test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.6.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
